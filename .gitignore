# Rust
/target
**/*.rs.bk

# wasm-pack output. `/crates/gnss-wasm/pkg` is the crate's own default
# out-dir, unused in practice -- `build:wasm` redirects straight to
# `/web/src/wasm`, which IS committed: Vercel's build image has no Rust
# toolchain, so the compiled module has to already be in the tree for
# `next build` to pick up. Rebuild it with `npm run build:wasm` before
# committing whenever gnss-core or gnss-wasm changes, and commit the result.
/crates/gnss-wasm/pkg

# Node / Next.js
node_modules
/web/.next
/web/out
/web/next-env.d.ts
/web/tsconfig.tsbuildinfo
.pnpm-store

# Ephemeris fetched on demand by /api/ephemeris and cached on disk
/data/cache

# Python
__pycache__/
*.pyc

# Env
.env*.local

# OS
.DS_Store

# Claude Code local permission grants and runtime state (session-specific)
.claude/settings.local.json
.claude/scheduled_tasks.lock
